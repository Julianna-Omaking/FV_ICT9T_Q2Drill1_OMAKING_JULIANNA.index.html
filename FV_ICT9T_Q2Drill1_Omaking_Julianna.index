<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Q2 Drill 1</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            background-color: #2a5fbf;
            font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        }
        .h1 {
            background: white;
            border-radius: 14px;
            box-shadow: 4px 4px 8px black;
            padding: 10px 20px;
            margin: 24px;
            color:#1b1b1b;
            text-align: center;
        }
        .taek img{
            height: 20px;
            width: 20px;
        }
    .card1 {
        background: white;
        border-radius: 6px;
        box-shadow: 4px 4px 8px black;
        padding: 16px 20px 24px;
        height: 100%;
    }
    .info h2 {
        background:rgba(245, 29, 0, 0.845);
        border-radius: 6px;
        padding: 6px 12px;
        margin-bottom: 14px;
    }
    .card1 ul{
        margin: 0;
    }
    .card1 li {
        margin-bottom: 4px;
    }
    </style>
</head>
<body>
    <div class="container">
        <h1>Quickstart to Taekwondo</h1>
    </div>
     <div class="row g-4">
        <div class="col-12 col-md-4">
    <section class="card1">
        <h2>Basic Rules</h2>
        <ul>
            <li>Head kick - 3 points</li>
            <li>Body - 2 points</li>
            <li>Punch - 1 point</li>
        </ul>
    </section>
    </div>

        <div class="row g-4">
        <div class="col-12 col-md-4">
            <section class="card1">
        <h2>Equipment</h2>
        <ul>
            <li>Dobok (Taekwondo Uniform)</li>
            <li>Belt</li>
            <li>Sparring Gear</li>
        </ul>
        </section>
        </div>

        <div class="row g-4">
        <div class="col-12 col-md-4">
             <section class="card1">
        <h2>Techniques</h2>
        <ul>
            <li>45 kick</li>
            <li>Roundhouse kick</li>
            <li>Front kick</li>
        </ul>
    </section>
     </div>
     </div>
    
</body>
</html>
